<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/panelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPanelSize"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@string/panel_btn_size"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dotsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp" />

    <!-- Observation 2.0 controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <Button
            android:id="@+id/btnObsToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:text="@string/obs_off"
            android:textColor="@color/on_primary"
            android:textSize="11sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btnObsShot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/obs_screenshot"
            android:textColor="@color/text_main"
            android:textSize="11sp"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtTableState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="4dp"
        android:text="@string/obs_state_idle_fmt"
        android:textColor="@color/text_main"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtLastRead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/confirmRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/obs_confirm_title"
            android:textColor="@color/warning"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnConfirmBlue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_blue"
                android:textColor="@color/on_primary"
                android:textSize="11sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnConfirmRed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/btn_red"
                android:textColor="@color/on_primary"
                android:textSize="11sp"
                app:backgroundTint="@color/red"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnConfirmTie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/btn_tie"
                android:textColor="@color/on_primary"
                android:textSize="11sp"
                app:backgroundTint="#475569"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="6dp"
        android:text="@string/panel_next"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_blue" />

        <ProgressBar
            android:id="@+id/barBlue"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="33"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/primary" />

        <TextView
            android:id="@+id/txtBluePct"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="—"
            android:textColor="@color/text_main"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_red" />

        <ProgressBar
            android:id="@+id/barRed"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="33"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/red" />

        <TextView
            android:id="@+id/txtRedPct"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="—"
            android:textColor="@color/text_main"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_tie" />

        <ProgressBar
            android:id="@+id/barTie"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="33"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/tie" />

        <TextView
            android:id="@+id/txtTiePct"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="—"
            android:textColor="@color/text_main"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPanelQuality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="6dp"
        android:text="@string/panel_quality_fmt"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txtObsInterp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="4dp"
        android:text="@string/obs_no_data"
        android:textColor="@color/text_main"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txtObsMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/warning"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="2dp"
        android:text="@string/panel_disclaimer"
        android:textColor="@color/warning"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/btnPanelOpen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/panel_btn_open"
            android:textColor="@color/on_primary"
            android:textSize="11sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btnPanelMinimize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/panel_btn_min"
            android:textColor="@color/text_main"
            android:textSize="11sp"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btnPanelClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/panel_btn_close"
            android:textColor="@color/on_primary"
            android:textSize="11sp"
            app:backgroundTint="@color/red"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
